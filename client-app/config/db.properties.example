# ============================================================
# 数据库连接配置模板
# 用法：复制一份改名为 db.properties，然后按本机情况修改。
#   config/db.properties 已被 git 忽略，各人维护自己的本地配置；
#   如需覆盖，可再放一份 config/db.local.properties（同样被忽略）。
# ============================================================

# 切换到 Rust 引擎（MiniDB）时填这个：自定义 TCP 文本协议，不走 JDBC
db.host=127.0.0.1
db.port=9000
db.user=root
db.password=

# ---- 历史参考：本地 MySQL 的写法（已弃用）----
# db.driver=com.mysql.cj.jdbc.Driver
# db.url=jdbc:mysql://127.0.0.1:3306/dbms_course?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&characterEncoding=utf8
